# Copy to .env to override defaults used by docker-compose.yml.
POSTGRES_PASSWORD=change-me
CORE_PORT=8080
# Admin UI (http://localhost:8080/admin/) basic-auth password. Empty = no login.
ADMIN_PASSWORD=change-me
# How long calls (row + audio file) are kept after the call ends.
RETENTION=720h
CLEANUP_INTERVAL=1h
PLUGIN_TIMEOUT=75s
MAX_CALL_DURATION=4h

# --- aivoice plugin / detector service ---
# Used when a call's variables don't include encoding / sample_rate.
#AIVOICE_DEFAULT_ENCODING=mulaw
#AIVOICE_DEFAULT_SAMPLE_RATE=8000
DETECTOR_WORKERS=2
DETECTOR_TORCH_THREADS=2
DETECTOR_UPDATE_INTERVAL=24h
# Optional commercial APIs (off unless set). These send call audio to the vendor.
#RESEMBLE_API_KEY=
#REALITY_DEFENDER_API_KEY=
